# Environment contract — copy to .env and adjust values.
# Local development points at the compose Postgres on localhost:
DATABASE_URL="postgresql://bia:bia@localhost:5432/bia_dev"
# NOTE: inside the docker compose backend service the host is `postgres`
# (see docker-compose.yml), not localhost.

# OpenAI-compatible provider (used by the analysis pipeline in a later slice).
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL=""

# Better Auth (autenticación por cookie de sesión httpOnly). BETTER_AUTH_SECRET
# debe tener al menos 32 caracteres; genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL pública del backend (base para cookies y callbacks de auth).
BETTER_AUTH_URL="http://localhost:3000"
# Origen del frontend (mejor-auth lo valida en el header Origin para el sign-in).
FRONTEND_ORIGIN="http://localhost:5173"
# Credenciales del usuario admin sembrado (opcional; hay defaults documentados
# en el README — no uses los defaults en producción).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin123!"

# HTTP port for the backend.
PORT=3000
